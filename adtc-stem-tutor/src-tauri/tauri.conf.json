{
  "productName": "NEXA STEM Tutor",
  "version": "1.0.0",
  "identifier": "com.nexa.stemtutor",
  "build": {
      "beforeDevCommand": "npm run dev",
      "beforeBuildCommand": "npm run build",
      "devUrl": "http://localhost:1520",
      "frontendDist": "../build" 
  },
  "app": {
    "windows": [
      {
        "title": " Localized STEM Virtual Lab Tutor",
        "width": 950,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "publisher": "ADTC",
    "copyright": "© 2026 AXE. All rights reserved.",
    "category": "Education",
    "shortDescription": "STEM Tutor",
    "longDescription": "NEXA STEM Tutor - interactive learning application for STEM education.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
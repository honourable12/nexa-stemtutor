{
  "productName": "Localized STEM Tutor",
  "version": "1.0.0",
  "identifier": "com.adtc.stemtutor",
  "build": {
      "beforeDevCommand": "npm run dev",
      "beforeBuildCommand": "npm run build",
      "devUrl": "http://localhost:1420",
      "frontendDist": "../build" 
  },
  "app": {
    "windows": [
      {
        "title": " Localized STEM Virtual Lab Tutor",
        "width": 950,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}